{
  "name": "youtube-personal-feed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing your personal YouTube subscription feed (Data API v3, OAuth)",
  "license": "MIT",
  "bin": {
    "youtube-feed-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "auth": "tsx src/auth.ts",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "google-auth-library": "^11.0.0",
    "googleapis": "^174.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
